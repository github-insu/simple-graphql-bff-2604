type Query {
    user(id: ID!): User
    users: [User!]!

    post(id: ID!): Post
    posts: [Post!]!
}

type Mutation {
    signUpUser(input: SignUpUserInput!): User!
    editUser(input: EditUserInput!): User!
    deleteUser(id: ID!): ID!

    publishPost(input: PublishPostInput!): Post!
    editPost(input: EditPostInput!): Post!
    deletePost(input: DeletePostInput!): ID!
}

type User {
    id: ID!
    name: String!

    posts: [Post!]!
}

type Post {
    id: ID!
    title: String!
    content: String!

    author: User!
}

input SignUpUserInput {
    name: String!
}

input EditUserInput {
    id: ID!
    name: String!
}

input PublishPostInput {
    title: String!
    content: String!

    userId: ID!
}

input EditPostInput {
    id: ID!
    title: String
    content: String

    userId: ID!
}

input DeletePostInput {
    id: ID!

    userId: ID!
}