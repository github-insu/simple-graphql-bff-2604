type Query {
    user(id: ID!): User
    users: [User!]!

    post(id: ID!): Post
    posts: [Post!]!
}

type Mutation {
    createUser(input: CreateUserInput!): User!
    updateUser(input: UpdateUserInput!): User!
    deleteUser(id: ID!): ID!

    createPost(input: CreatePostInput!): Post!
    updatePost(input: UpdatePostInput!): Post!
    deletePost(userId: ID!): ID!
}

type User {
    id: ID!
    name: String!

    posts: [Post!]!
}

type Post {
    id: ID!
    title: String!
    content: String!

    author: User!
}

input CreateUserInput {
    name: String!
}

input UpdateUserInput {
    id: ID!
    name: String!
}

input CreatePostInput {
    title: String!
    content: String!
}

input UpdatePostInput {
    id: ID!
    title: String
    content: String
}